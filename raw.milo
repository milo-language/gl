// `offset` is a byte offset into the bound element buffer, cast from an integer.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDrawElements(GLenum, GLsizei, GLenum, const void *)")
pub extern fn glDrawElements(mode: u32, count: i32, kind: u32, offset: *u8)

