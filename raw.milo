@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glTexSubImage2D(GLenum, GLint, GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, const void *)")
pub extern fn glTexSubImage2D(target: u32, level: i32, x: i32, y: i32, w: i32, h: i32, format: u32, kind: u32, pixels: *u8)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glTexParameteri(GLenum, GLenum, GLint)")
pub extern fn glTexParameteri(target: u32, pname: u32, param: i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGenerateMipmap(GLenum)")
pub extern fn glGenerateMipmap(target: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDeleteTextures(GLsizei, const GLuint *)")
pub extern fn glDeleteTextures(n: i32, ids: *u32)

