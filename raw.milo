// gl/raw — raw OpenGL 3.3 core bindings.
//
// This is the unsafe floor: one `extern fn` per GL entry point, one `let` per
// constant, and nothing else. Use `std/gpu` unless you need a call this does not
// wrap — `gl` owns the shader/buffer/texture/framebuffer lifecycles and keeps the
// raw pointers out of your program.
//
// The link flag comes from `link.darwin.milo` / `link.linux.milo`, the one pair of
// files that differs per platform: `-framework OpenGL` on darwin, `-lGL` elsewhere.
// Windows is not a target of this package — `opengl32.dll` exports GL 1.1 only, so
// every 3.3 entry point here would be an undefined symbol. `milo.json` says so.
//
// A current GL context is a precondition of every call. Creating one is the
// window system's job, not this module's: with SDL2 that is
// `SDL_GL_SetAttribute` + `SDL_WINDOW_OPENGL` + `SDL_GL_CreateContext`. Calling
// into GL with no context bound is undefined behaviour, not an error return.
//
// Every pointer parameter is declared with the pointee GL actually writes or
// reads: `*u32` for a GLuint name, `*i32` for a GLint or GLsizei out-param,
// `*f32` for a float array. That is not decoration — an out-param is the callee
// writing into the caller's frame, so the pointee width IS the contract, and a
// local of the wrong type is a stack overwrite that links and runs. Spelled
// precisely, the call site needs no cast and the checker rejects the mismatch.
//
// `*u8` appears only where C really says `void *` (pixel and vertex payloads,
// whose element type is a runtime GLenum) or where the pointer value is a byte
// offset rather than an address.
//
// Each declaration carries `@cSig`, so the claim is checked against the real GL
// header at build time on any machine that has one. The two spellings cover
// macOS and Mesa; a machine with neither gets a named warning, not a silent pass.

// ── state ─────────────────────────────────────────────────────────────────────

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glClearColor(GLfloat, GLfloat, GLfloat, GLfloat)")
pub extern fn glClearColor(r: f32, g: f32, b: f32, a: f32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glClear(GLbitfield)")
pub extern fn glClear(mask: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glViewport(GLint, GLint, GLsizei, GLsizei)")
pub extern fn glViewport(x: i32, y: i32, w: i32, h: i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glScissor(GLint, GLint, GLsizei, GLsizei)")
pub extern fn glScissor(x: i32, y: i32, w: i32, h: i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glEnable(GLenum)")
pub extern fn glEnable(cap: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDisable(GLenum)")
pub extern fn glDisable(cap: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glBlendFunc(GLenum, GLenum)")
pub extern fn glBlendFunc(src: u32, dst: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDepthFunc(GLenum)")
pub extern fn glDepthFunc(func: u32)

// GLboolean, so 0 or 1 — anything else is out of contract.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDepthMask(GLboolean)")
pub extern fn glDepthMask(flag: u8)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glCullFace(GLenum)")
pub extern fn glCullFace(mode: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glFrontFace(GLenum)")
pub extern fn glFrontFace(mode: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glPixelStorei(GLenum, GLint)")
pub extern fn glPixelStorei(pname: u32, param: i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glFinish(void)")
pub extern fn glFinish()


// Returns a static NUL-terminated string owned by the driver — read it with
// std/cstr, never free it.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "const GLubyte *glGetString(GLenum)")
pub extern fn glGetString(name: u32): *u8

// ── shaders ───────────────────────────────────────────────────────────────────

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "GLuint glCreateShader(GLenum)")
pub extern fn glCreateShader(kind: u32): u32

// `lengths` may be NULL, meaning every source string is NUL-terminated.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glShaderSource(GLuint, GLsizei, const GLchar *const*, const GLint *)")
pub extern fn glShaderSource(shader: u32, count: i32, strings: **u8, lengths: *i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glCompileShader(GLuint)")
pub extern fn glCompileShader(shader: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGetShaderiv(GLuint, GLenum, GLint *)")
pub extern fn glGetShaderiv(shader: u32, pname: u32, out: *i32)

// `length` may be NULL; `log` is a caller-owned buffer of `bufSize` bytes.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGetShaderInfoLog(GLuint, GLsizei, GLsizei *, GLchar *)")
pub extern fn glGetShaderInfoLog(shader: u32, bufSize: i32, length: *i32, log: *u8)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDeleteShader(GLuint)")
pub extern fn glDeleteShader(shader: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "GLuint glCreateProgram(void)")
pub extern fn glCreateProgram(): u32

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glAttachShader(GLuint, GLuint)")
pub extern fn glAttachShader(program: u32, shader: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glLinkProgram(GLuint)")
pub extern fn glLinkProgram(program: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGetProgramiv(GLuint, GLenum, GLint *)")
pub extern fn glGetProgramiv(program: u32, pname: u32, out: *i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGetProgramInfoLog(GLuint, GLsizei, GLsizei *, GLchar *)")
pub extern fn glGetProgramInfoLog(program: u32, bufSize: i32, length: *i32, log: *u8)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUseProgram(GLuint)")
pub extern fn glUseProgram(program: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDeleteProgram(GLuint)")
pub extern fn glDeleteProgram(program: u32)

// `name` is NUL-terminated. Returns -1 if the uniform is not active, which includes
// "the linker optimised it away because nothing read it".
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "GLint glGetUniformLocation(GLuint, const GLchar *)")
pub extern fn glGetUniformLocation(program: u32, name: *u8): i32

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniform1i(GLint, GLint)")
pub extern fn glUniform1i(loc: i32, v0: i32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniform1f(GLint, GLfloat)")
pub extern fn glUniform1f(loc: i32, v0: f32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniform2f(GLint, GLfloat, GLfloat)")
pub extern fn glUniform2f(loc: i32, v0: f32, v1: f32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniform3f(GLint, GLfloat, GLfloat, GLfloat)")
pub extern fn glUniform3f(loc: i32, v0: f32, v1: f32, v2: f32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniform4f(GLint, GLfloat, GLfloat, GLfloat, GLfloat)")
pub extern fn glUniform4f(loc: i32, v0: f32, v1: f32, v2: f32, v3: f32)

// `value` holds count*16 floats.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glUniformMatrix4fv(GLint, GLsizei, GLboolean, const GLfloat *)")
pub extern fn glUniformMatrix4fv(loc: i32, count: i32, transpose: u8, value: *f32)

// ── buffers ───────────────────────────────────────────────────────────────────

// The driver writes `n` names into `ids`.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGenBuffers(GLsizei, GLuint *)")
pub extern fn glGenBuffers(n: i32, ids: *u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glBindBuffer(GLenum, GLuint)")
pub extern fn glBindBuffer(target: u32, id: u32)

// `size` is a GLsizeiptr — pointer-sized, hence i64. `data` may be NULL to allocate
// without uploading.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glBufferData(GLenum, GLsizeiptr, const void *, GLenum)")
pub extern fn glBufferData(target: u32, size: i64, data: *u8, usage: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glBufferSubData(GLenum, GLintptr, GLsizeiptr, const void *)")
pub extern fn glBufferSubData(target: u32, offset: i64, size: i64, data: *u8)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDeleteBuffers(GLsizei, const GLuint *)")
pub extern fn glDeleteBuffers(n: i32, ids: *u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGenVertexArrays(GLsizei, GLuint *)")
pub extern fn glGenVertexArrays(n: i32, ids: *u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glBindVertexArray(GLuint)")
pub extern fn glBindVertexArray(id: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDeleteVertexArrays(GLsizei, const GLuint *)")
pub extern fn glDeleteVertexArrays(n: i32, ids: *u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glEnableVertexAttribArray(GLuint)")
pub extern fn glEnableVertexAttribArray(index: u32)

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glDisableVertexAttribArray(GLuint)")
pub extern fn glDisableVertexAttribArray(index: u32)

// GL reads `offset` as a byte offset into the bound buffer, not as an address —
// pass `n as *u8`. That is why it is a pointer at all.
@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glVertexAttribPointer(GLuint, GLint, GLenum, GLboolean, GLsizei, const void *)")
pub extern fn glVertexAttribPointer(index: u32, size: i32, kind: u32, normalized: u8, stride: i32, offset: *u8)

// ── textures ──────────────────────────────────────────────────────────────────

@cSig("OpenGL/gl3.h|GL_GLEXT_PROTOTYPES+GL/glcorearb.h", "void glGenTextures(GLsizei, GLuint *)")
pub extern fn glGenTextures(n: i32, ids: *u32)

